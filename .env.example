# Environment Variables for Dotfiles Configuration
# Copy this file to ~/.env and fill in your actual values
# WARNING: Never commit the actual .env file to version control!

# Anthropic API Key (for Claude Code CLI)
# Get your key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="your-anthropic-api-key-here"

# MQTT Configuration (for local MQTT server)
MQTT_HOST="192.168.40.2"
MQTT_PORT="1883"
MQTT_USER="admin"
MQTT_PASSWORD="your-mqtt-password-here"

# Borg Backup Configuration
# Note: Borg passphrase should be stored in ~/.config/borg-passphrase
# This is already configured correctly in the aliases
BORG_REPO="ssh://hetzner-backup/./backups/x1carbon"
